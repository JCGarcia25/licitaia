# ==========================================================
# LicitaIA — Variables de entorno (copiar a .env y completar)
# ==========================================================

# --- Aplicación ---
ENVIRONMENT=development
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000
DEBUG_ENDPOINT_TOKEN=development25
DEBUG_ENDPOINT_ENABLED=false

# --- Base de datos (Postgres con pgvector en producción) ---
DATABASE_URL=postgresql+psycopg2://licitaia:licitaia_dev@localhost:5432/licitaia
# Para desarrollo rápido sin Postgres: DATABASE_URL=sqlite:///./licitaia.db
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage

# --- SECOP / Socrata (datos.gov.co) ---
# Registrar un app token en https://profile.socrata.com (mejor límite por aplicación)
SECOP_APP_TOKEN=
SECOP_DOMAIN=www.datos.gov.co
SECOP_PAGE_SIZE=1000
SECOP_MAX_PAGES_PER_RUN=25
SECOP_SYNC_EVERY_MINUTES=30

# --- Inteligencia artificial (proveedor configurable) ---
EMBEDDING_PROVIDER=fake        # fake | openai
EMBEDDING_DIM=768
LLM_PROVIDER=heuristic         # heuristic | openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Alertas por correo (opcional; in-app siempre activa) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERTS_FROM_EMAIL=alertas@tudominio.co
ALERT_HIGH_SCORE=70
ALERT_CLOSE_DAYS=10,5,1
DIGEST_HOUR=7                  # hora local America/Bogota
TIMEZONE=America/Bogota

# --- Postgres (docker-compose) ---
POSTGRES_DB=licitaia
POSTGRES_USER=licitaia
POSTGRES_PASSWORD=licitaia_dev

# --- Billing Mercado Pago (sandbox/producción; nunca subir secretos al repo) ---
BILLING_PROVIDER=manual
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_TEST_PAYER_EMAIL=
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_BACK_URL=https://licitaia.centralspike.com/app/plan

# --- Frontend (Next.js; se fija en build) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# Compatibility Engine V2 — Fase 1.2 (recursos por lote; sin límite del universo)
MATCH_BATCH_SIZE=200
MATCH_GLOBAL_CONCURRENCY=2
MATCH_LEASE_SECONDS=300
MATCH_MAX_RETRIES=3
MATCH_ALGORITHM_VERSION=heuristic-v1-phase12

# Experimental private V2; enable only in isolated DEV, separate worker queue.
COMPATIBILITY_V2_SHADOW_ENABLED=false
COMPATIBILITY_V2_SAMPLE_LIMIT=20
COMPATIBILITY_V2_BATCH_SIZE=5
COMPATIBILITY_V2_LEASE_SECONDS=120
# Start an explicit bounded worker: celery -A app.workers.celery_app.celery_app worker -Q compatibility-shadow --concurrency=1

# Evaluation 2.1: fail-closed, no operational DEV destination authorized by default.
EVALUATION_ENABLED=false
TVEC_EVENTS_ENABLED=false
TVEC_EVENTS_REFRESH_ENABLED=false
TVEC_ENABLED=false
TVEC_INGEST_ENABLED=false
TVEC_DEV_TARGETS=[]
TVEC_API_ORIGIN=http://localhost:8000
TVEC_PAGE_SIZE=100
TVEC_MAX_PAGES=2
TVEC_LEASE_SECONDS=180
EVALUATION_API_ORIGIN=http://localhost:8000
EVALUATION_DEV_TARGETS=[]
EVALUATION_SEMANTIC_ENABLED=false
EVALUATION_EXTERNAL_MAX_CALLS=0
# Configure tariff explicitly, e.g. EVALUATION_EMBEDDING_USD_PER_MILLION_TOKENS=<reviewed tariff>
EVALUATION_MAX_COST_USD=0.25
EVALUATION_RETENTION_DAYS=30
