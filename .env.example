# ==========================================================
# LicitaIA — Variables de entorno (copiar a .env y completar)
# ==========================================================

# --- Aplicación ---
ENVIRONMENT=development
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000
DEBUG_ENDPOINT_TOKEN=development25
DEBUG_ENDPOINT_ENABLED=false

# --- Base de datos (Postgres con pgvector en producción) ---
DATABASE_URL=postgresql+psycopg2://licitaia:licitaia_dev@localhost:5432/licitaia
# Para desarrollo rápido sin Postgres: DATABASE_URL=sqlite:///./licitaia.db
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage

# --- SECOP / Socrata (datos.gov.co) ---
# Registrar un app token en https://profile.socrata.com (mejor límite por aplicación)
SECOP_APP_TOKEN=
SECOP_DOMAIN=www.datos.gov.co
SECOP_PAGE_SIZE=1000
SECOP_MAX_PAGES_PER_RUN=25
SECOP_SYNC_EVERY_MINUTES=30

# --- Inteligencia artificial (proveedor configurable) ---
EMBEDDING_PROVIDER=fake        # fake | openai
EMBEDDING_DIM=768
LLM_PROVIDER=heuristic         # heuristic | openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Alertas por correo (opcional; in-app siempre activa) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERTS_FROM_EMAIL=alertas@tudominio.co
ALERT_HIGH_SCORE=70
ALERT_CLOSE_DAYS=10,5,1
DIGEST_HOUR=7                  # hora local America/Bogota
TIMEZONE=America/Bogota

# --- Postgres (docker-compose) ---
POSTGRES_DB=licitaia
POSTGRES_USER=licitaia
POSTGRES_PASSWORD=licitaia_dev

# --- Frontend (Next.js; se fija en build) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
